# Maintainer: ZenithClient
pkgname=ZenithClient
pkgver=2.10.1
pkgrel=1
pkgdesc="Next-generation open source Minecraft launcher (built from source)"
arch=('x86_64')
url="https://github.com/ac-zap/Zap.CC"
license=('GPL-3.0-only')
depends=(
  'fontconfig'
  'freetype2'
  'libglvnd'
  'libxcursor'
  'libxrandr'
  'libxi'
  'libxkbcommon'
  'wayland'
  'dbus'
)
makedepends=(
  'rust'
  'cargo'
  'cmake'
  'clang'
  'pkgconf'
  'python'
)
provides=('ZenithClient')
conflicts=('zenithclient-bin')
options=(
  '!lto'
  '!debug'
)
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/zenithclient-${pkgver}.tar.gz")
sha256sums=('SKIP')

_srcdir="zenith-client-${pkgver}"

prepare() {
  cd "$srcdir/$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen --bin ZenithClient_app
}

package() {
  cd "$srcdir/$_srcdir"
  install -Dm755 "target/release/ZenithClient_app" "$pkgdir/usr/bin/ZenithClient_app"
  ln -s ZenithClient_app "$pkgdir/usr/bin/ZenithClient"

  for dir in packages/zenithclient_app/distribution/linux/icons/*/; do
    size=$(basename "$dir")
    install -Dm644 "$dir/ZenithClient.png" "$pkgdir/usr/share/icons/hicolor/$size/apps/ZenithClient.png"
  done

  install -Dm644 "packages/zenithclient_app/distribution/linux/ZenithClient.desktop" \
    "$pkgdir/usr/share/applications/ZenithClient.desktop"
  install -Dm644 "distribution/flatpak/cc.zenith.client.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/cc.zenith.client.metainfo.xml"
}
