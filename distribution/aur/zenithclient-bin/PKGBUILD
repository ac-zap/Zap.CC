# Maintainer: ZenithClient
pkgname=zenithclient-bin
pkgver=2.10.1
pkgrel=1
pkgdesc="Next-generation open source Minecraft launcher (prebuilt)"
arch=('x86_64')
url="https://github.com/ac-zap/Zap.CC"
license=('GPL-3.0-only')
depends=(
  'fontconfig'
  'freetype2'
  'libglvnd'
  'libxcursor'
  'libxrandr'
  'libxi'
  'libxkbcommon'
  'wayland'
  'dbus'
)
provides=('ZenithClient')
conflicts=('ZenithClient')
options=(
  '!lto'
  '!debug'
)
source=("$pkgname-$pkgver.deb::${url}/releases/download/zenithclient-${pkgver}/ZenithClient_${pkgver}_linux_x86_64.deb")
sha256sums=('SKIP')

package() {
  bsdtar -xf "$srcdir/data.tar.xz" -C "$pkgdir"
  ln -s ZenithClient_app "$pkgdir/usr/bin/ZenithClient"
}
